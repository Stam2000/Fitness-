generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Authentification (Better Auth)
//
// Ces quatre modèles sont générés par `npx @better-auth/cli generate` : ne pas
// les modifier à la main, hormis les relations vers les modèles de l'app
// ajoutées ci-dessous. Les `@@map` en minuscules sont ceux qu'attend Better
// Auth — les changer casse l'adaptateur.
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // « admin » (premier compte, créé par /setup) ou null/« user ».
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  // Données personnelles. Le catalogue partagé (Equipment, Muscle,
  // MuscleCombo, MovementVideo) et les réglages globaux n'y figurent pas.
  locations         Location[]
  programs          Program[]
  workoutSessions   WorkoutSession[]
  bodyMeasurements  BodyMeasurement[]
  progressPhotos    ProgressPhoto[]
  chatConversations ChatConversation[]
  settings          UserSettings?
  nutritionGoal     NutritionGoal?
  meals             Meal[]
  cardioSessions    CardioSession[]
  invitesCreated    InviteCode[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Code d'invitation : l'inscription publique est fermée, il faut présenter un
// code valide. Consommé de façon atomique (usedCount < maxUses) au moment de
// l'inscription — voir registerWithInvite dans src/app/auth-actions.ts.
model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique
  label       String?
  maxUses     Int       @default(1)
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  // Révoqué manuellement par l'admin : inutilisable même s'il reste des places.
  revokedAt   DateTime?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([createdById])
}

// Préférences personnelles. Les clés API et le choix des modèles restent dans
// Settings (global, réservé à l'admin) : c'est son budget qui est consommé.
model UserSettings {
  userId        String  @id
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  voiceInput    Boolean @default(true)
  voiceAnnounce Boolean @default(true)
}

// Objectifs nutritionnels : poids visé et apports quotidiens. Une seule ligne
// par compte, réécrite à chaque modification — ce sont des cibles courantes,
// pas un historique (la progression réelle se lit dans BodyMeasurement).
//
// Les trois cibles sont stockées telles que l'utilisateur les a validées, même
// lorsqu'elles proviennent du calcul automatique : changer plus tard la formule
// de suggestion ne doit pas déplacer un objectif déjà fixé.
model NutritionGoal {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // « gain » (prise de masse) | « recomp » | « cut » (sèche) — voir
  // OBJECTIVES dans src/lib/nutrition.ts.
  objective      String   @default("gain")
  // « low » | « moderate » | « high » : niveau d'activité, sert uniquement à
  // estimer la maintenance calorique.
  activity       String   @default("moderate")
  targetWeightKg Float?
  dailyCalories  Int?
  dailyProteinG  Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Repas photographié puis estimé par le modèle multimodal. Là où
// NutritionGoal porte l'intention (les cibles), Meal porte la mesure : ce qui
// a réellement été mangé. La photo est conservée telle quelle — c'est la
// seule pièce vérifiable si l'estimation paraît fausse plus tard.
model Meal {
  id        String     @id @default(cuid())
  eatenAt   DateTime   @default(now())
  imageUrl  String?
  // Précisions saisies (ou dictées) par l'utilisateur avant l'analyse :
  // ce que la photo ne peut pas montrer (« cuit à l'huile d'olive »).
  note      String?
  // Nom court donné au repas par le modèle (« Poulet riz brocolis »).
  title     String?
  // « pending » | « ready » | « failed ». La photo est téléversée puis
  // analysée en DEUX requêtes : une estimation prend cinq à quinze secondes,
  // trop pour tenir une connexion mobile ouverte. La ligne existe donc dès
  // l'envoi, et un échec laisse un repas relançable plutôt qu'un cliché
  // envolé.
  status    String     @default("pending")
  // Message d'échec, affiché tel quel à côté du bouton « Relancer ».
  error     String?
  // Modèle ayant produit l'estimation — utile quand on en change.
  model     String?
  // Phrase du modèle sur ce qui rend son estimation incertaine.
  comment   String?
  items     MealItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, eatenAt])
}

// Composant d'un repas. Les totaux ne sont volontairement PAS stockés sur
// Meal : ils se déduisent des lignes incluses (mealTotals dans
// src/lib/meals.ts), ce qui rend impossible toute dérive entre le total
// affiché et le détail qui le justifie.
// Ligne d'un repas. Deux natures cohabitent, distinguées par `kind` :
// « detected »   — vu dans l'assiette, retenu par défaut ;
// « hypothesis » — ce que la photo NE PEUT PAS montrer (huile de cuisson,
//                  sauce, sucre…), d'où `question` : une question fermée,
//                  écartée du total tant qu'elle n'a pas reçu de réponse ;
// « manual »     — saisie à la main (valeur réservée, pas encore exposée).
//
// `answeredAt` date la décision de l'utilisateur. Une hypothèse sans réponse
// n'est PAS une hypothèse refusée : dans le premier cas le total est un
// minimum connu (« + 320 kcal en attente de réponse »), dans le second il est
// arrêté. L'écran doit pouvoir dire les deux.
//
// Pas de `userId` : la ligne ne s'atteint que par son repas, dont elle suit
// le propriétaire et le sort (cascade) — même raison que ProgramDay.
model MealItem {
  id            String    @id @default(cuid())
  mealId        String
  meal          Meal      @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name          String
  // Libellé de portion tel que formulé (« 1 filet », « ~150 g », « 1 bol »).
  quantityLabel String?
  // Masse estimée : base du recalcul proportionnel quand l'utilisateur
  // corrige la quantité. Null quand le modèle n'a pas su la chiffrer — l'UI
  // propose alors un multiplicateur de portion plutôt que des grammes.
  grams         Float?
  // Entier : afficher des décimales de calories laisserait croire à une
  // précision qu'une estimation photo n'a pas.
  kcal          Int       @default(0)
  proteinG      Float     @default(0)
  carbsG        Float     @default(0)
  fatG          Float     @default(0)
  kind          String    @default("detected")
  question      String?
  // Seule source de vérité du total : l'utilisateur peut aussi bien retenir
  // une hypothèse que écarter un aliment que le modèle a cru voir.
  included      Boolean   @default(true)
  answeredAt    DateTime?
  order         Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([mealId])
}

// ---------------------------------------------------------------------------

// Contexte d'entraînement : « Maison », « Salle », etc.
model Location {
  id        String              @id @default(cuid())
  name      String
  icon      String?
  equipment LocationEquipment[]
  programs  Program[]
  createdAt DateTime            @default(now())
  // Nullable le temps de la reprise des données existantes : la migration
  // `lock_owner_not_null` la passe en obligatoire une fois /setup effectué.
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Equipment {
  id          String              @id @default(cuid())
  name        String              @unique
  category    String
  imageUrl    String?
  imageTaskId String?
  locations   LocationEquipment[]
}

// Groupe musculaire du catalogue : liste seedée + ajouts créés par l'IA.
// Les exercices y font référence par nom (Exercise.muscles est un String[]).
model Muscle {
  id          String   @id @default(cuid())
  name        String   @unique
  imageUrl    String?
  imageTaskId String?
  createdAt   DateTime @default(now())
}

// Combinaison de groupes musculaires ciblée par un exercice (≥ 2 muscles),
// avec son illustration dédiée. `key` = noms normalisés triés, joints par "|"
// (voir muscleComboKey dans src/lib/normalize.ts) ; `muscles` garde les noms
// canoniques pour l'affichage et le prompt de génération.
model MuscleCombo {
  id          String   @id @default(cuid())
  key         String   @unique
  muscles     String[]
  imageUrl    String?
  imageTaskId String?
  createdAt   DateTime @default(now())
}

model LocationEquipment {
  locationId  String
  equipmentId String
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([locationId, equipmentId])
}

model Program {
  id                String             @id @default(cuid())
  name              String
  description       String?
  goal              String?
  level             String?
  locationId        String?
  location          Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  days              ProgramDay[]
  createdAt         DateTime           @default(now())
  // Durée du bloc en cycles complets (passages sur tous les jours), décidée
  // par l'IA à la génération. null = pas de suivi de bloc.
  blockCycles       Int?
  // N° du bloc dans la chaîne de progression (1 = bloc initial).
  blockNumber       Int                @default(1)
  // Bloc précédent dans la chaîne (un seul successeur par bloc).
  previousProgramId String?            @unique
  previousProgram   Program?           @relation("ProgramBlocks", fields: [previousProgramId], references: [id], onDelete: SetNull)
  nextProgram       Program?           @relation("ProgramBlocks")
  // Archivé automatiquement quand son successeur est enregistré.
  archivedAt        DateTime?
  versions          ProgramVersion[]
  chats             ChatConversation[]
  // Propriétaire — voir la note sur Location.userId.
  userId            String?
  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// État figé d'un programme à un instant donné. Une version est écrite après
// chaque modification du plan (édition manuelle, retouche par l'IA, promotion
// d'une variante, restauration) — et seulement si le plan a réellement changé,
// pour qu'un enregistrement sans modification ne pollue pas la liste.
//
// C'est un enregistrement de CONSULTATION : les séances gardent leur propre
// copie du jour travaillé (WorkoutSession.planSnapshot), si bien que supprimer
// un programme et ses versions ne retire rien à l'historique.
model ProgramVersion {
  id            String   @id @default(cuid())
  programId     String
  program       Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  // N° affiché, croissant à partir de 1 (version de création).
  versionNumber Int
  // « creation » | « edit » | « ai » | « restore » — origine du changement.
  source        String   @default("edit")
  // Libellé court de ce qui a changé, écrit par l'appelant.
  note          String?
  // Plan complet figé — voir ProgramSnapshot dans src/lib/program-versions.ts.
  snapshot      Json
  createdAt     DateTime @default(now())

  sessions WorkoutSession[]

  @@unique([programId, versionNumber])
  @@index([programId, createdAt])
}

// Conversation du panneau d'assistant IA. programId = programme sur lequel la
// conversation est ancrée (sélectionné dans l'en-tête du panneau).
model ChatConversation {
  id        String        @id @default(cuid())
  // Premier message de l'utilisateur, tronqué — sert de libellé d'historique.
  title     String?
  programId String?
  program   Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  // Propriétaire — voir la note sur Location.userId.
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String
  // Trace des outils exécutés pendant ce tour : [{ name, args, summary }].
  toolCalls      Json?
  // Proposition de modification produite par un outil propose_* (voir
  // src/lib/chat-tools.ts), en attente de confirmation dans le panneau.
  proposal       Json?
  proposalStatus String? // "pending" | "applied" | "rejected" | "stale"
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

model ProgramDay {
  id        String           @id @default(cuid())
  programId String
  program   Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  dayIndex  Int
  name      String
  focus     String?
  exercises Exercise[]
  sessions  WorkoutSession[]
}

model Exercise {
  id                String              @id @default(cuid())
  dayId             String
  day               ProgramDay          @relation(fields: [dayId], references: [id], onDelete: Cascade)
  order             Int
  name              String
  sets              Int
  reps              String
  restSeconds       Int
  weightHint        String?
  equipment         String[]
  // Muscles principaux travaillés (en français), renseignés par l'IA.
  muscles           String[]            @default([])
  // Temps cible pour boucler l'exercice (séries + repos), défini par l'IA.
  targetSeconds     Int?
  // Temps cible d'exécution d'UNE série, défini par l'IA.
  setSeconds        Int?
  // Temps de transition vers l'exercice suivant (installation), défini par l'IA.
  transitionSeconds Int?
  notes             String?
  // Description détaillée d'exécution (position, étapes, respiration,
  // erreurs), générée par l'IA à la demande puis mémorisée.
  howTo             String?
  imageUrl          String?
  imageTaskId       String?
  // Vidéo de démonstration du mouvement (Seedance via Kie.ai) et le prompt
  // détaillé qui a servi à la générer.
  videoUrl          String?
  videoTaskId       String?
  videoPrompt       String?
  variations        ExerciseVariation[]
}

// Variante d'un exercice (mêmes muscles), jouée en alternance selon les passages.
model ExerciseVariation {
  id            String   @id @default(cuid())
  exerciseId    String
  exercise      Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  order         Int
  name          String
  sets          Int
  reps          String
  restSeconds   Int
  weightHint    String?
  equipment     String[]
  // Muscles principaux travaillés (en français), renseignés par l'IA.
  muscles       String[] @default([])
  // Temps cible pour boucler la variante (séries + repos), défini par l'IA.
  targetSeconds Int?
  // Temps cible d'exécution d'UNE série, défini par l'IA.
  setSeconds    Int?
  notes         String?
  // Description détaillée d'exécution, générée par l'IA à la demande.
  howTo         String?
  imageUrl      String?
  imageTaskId   String?
  videoUrl      String?
  videoTaskId   String?
  videoPrompt   String?
}

// Séance réalisée. C'est un JOURNAL : une fois écrite, elle ne doit plus
// dépendre du programme vivant, sans quoi modifier son plan réécrirait le
// passé. D'où `planSnapshot` (ce qui était prescrit ce jour-là) et le lien
// `day` volontairement facultatif — supprimer un jour, voire le programme
// entier, détache la séance au lieu de l'effacer.
model WorkoutSession {
  id               String          @id @default(cuid())
  dayId            String?
  day              ProgramDay?     @relation(fields: [dayId], references: [id], onDelete: SetNull)
  // Plan du jour tel que prescrit, écrit au démarrage puis rafraîchi à la
  // clôture (une retouche en cours de séance est donc prise en compte).
  // Forme : SessionPlan dans src/lib/program-versions.ts. null pour les
  // séances antérieures à la migration dont le jour a disparu depuis.
  planSnapshot     Json?
  // Version du programme en vigueur à la clôture, pour l'étiquette « Plan v3 ».
  programVersionId String?
  programVersion   ProgramVersion? @relation(fields: [programVersionId], references: [id], onDelete: SetNull)
  startedAt        DateTime        @default(now())
  completedAt      DateTime?
  notes            String?
  aiFeedback       String?
  setLogs          SetLog[]
  // N° de passage sur ce jour, figé au démarrage de la séance.
  cycleIndex       Int             @default(0)
  // Overrides manuels de variante : { [exerciseId]: index choisi }.
  variationChoices Json            @default("{}")
  // Temps passé par exercice (secondes) : { [exerciseId]: secondes }.
  exerciseSeconds  Json            @default("{}")
  // Propriétaire — voir la note sur Location.userId. Dénormalisé depuis
  // day.program.userId pour filtrer l'historique sans jointure.
  userId           String?
  user             User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Série enregistrée. `exerciseId` est un identifiant de journal, pas une clé
// étrangère : la ligne Exercise correspondante peut être modifiée ou retirée
// du programme sans que la série disparaisse ni change de sens. C'est
// `exerciseName` (figé à l'écriture) qui fait foi pour l'historique et les
// courbes — renommer un exercice ne réattribue plus les séries passées.
model SetLog {
  id            String         @id @default(cuid())
  sessionId     String
  session       WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId    String
  // Nom de l'exercice prescrit au moment de la série.
  exerciseName  String
  setIndex      Int
  reps          Int?
  weightKg      Float?
  done          Boolean        @default(false)
  // Nom de la variante réellement exécutée (null = exercice de base).
  variationName String?

  @@unique([sessionId, exerciseId, setIndex])
  @@index([exerciseName])
}

// Vidéo YouTube de démonstration téléchargée pour un mouvement. Rattachée par
// nom normalisé (movementKey) : partagée entre l'exercice de base, ses
// variantes et tous les programmes portant le même mouvement.
model MovementVideo {
  id           String   @id @default(cuid())
  movementName String
  movementKey  String
  sourceUrl    String
  title        String?
  // Fichier local (/api/media/…) une fois le téléchargement terminé.
  videoUrl     String?
  status       String   @default("downloading") // downloading | ready | failed
  error        String?
  createdAt    DateTime @default(now())

  @@index([movementKey])
}

// Mesure corporelle saisie manuellement (valeurs lues p. ex. sur une montre
// à impédancemétrie — Galaxy Watch / balance connectée).
model BodyMeasurement {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  weightKg     Float?
  muscleMassKg Float?
  bodyFatPct   Float?
  notes        String?
  createdAt    DateTime @default(now())
  // Propriétaire — voir la note sur Location.userId.
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Photo de suivi physique, stockée dans le volume média local (/api/media).
model ProgressPhoto {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  imageUrl  String
  note      String?
  createdAt DateTime @default(now())
  // Propriétaire — voir la note sur Location.userId.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Settings {
  id               Int      @id @default(1)
  openrouterApiKey String?
  openrouterModel  String   @default("openai/gpt-4o-mini")
  // Modèles épinglés, remontés en tête de liste dans le sélecteur.
  pinnedModels     String[]
  kieApiKey        String?
  voiceInput       Boolean  @default(true)
  voiceAnnounce    Boolean  @default(true)
  // Modèle acceptant l'audio (dictée directe au micro via OpenRouter).
  voiceModel       String   @default("google/gemini-2.5-flash")
  // Modèle acceptant les images (estimation calorique d'une photo de repas).
  visionModel      String   @default("google/gemini-2.5-flash")
}

// Séance de cardio saisie à la main (tapis de course). Les calories sont
// estimées à partir de la vitesse, de la pente et du poids — voir
// src/lib/cardio.ts. Le poids retenu est figé sur la ligne : une pesée
// ultérieure ne doit pas réécrire l'historique.
model CardioSession {
  id          String   @id @default(cuid())
  kind        String   @default("treadmill")
  speedKmh    Float
  inclinePct  Float    @default(0)
  minutes     Float
  distanceKm  Float
  calories    Int
  weightKg    Float
  performedAt DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, performedAt])
}
