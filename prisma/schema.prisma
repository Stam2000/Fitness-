generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Contexte d'entraînement : « Maison », « Salle », etc.
model Location {
  id        String              @id @default(cuid())
  name      String
  icon      String?
  equipment LocationEquipment[]
  programs  Program[]
  createdAt DateTime            @default(now())
}

model Equipment {
  id          String              @id @default(cuid())
  name        String              @unique
  category    String
  imageUrl    String?
  imageTaskId String?
  locations   LocationEquipment[]
}

// Groupe musculaire du catalogue : liste seedée + ajouts créés par l'IA.
// Les exercices y font référence par nom (Exercise.muscles est un String[]).
model Muscle {
  id          String   @id @default(cuid())
  name        String   @unique
  imageUrl    String?
  imageTaskId String?
  createdAt   DateTime @default(now())
}

// Combinaison de groupes musculaires ciblée par un exercice (≥ 2 muscles),
// avec son illustration dédiée. `key` = noms normalisés triés, joints par "|"
// (voir muscleComboKey dans src/lib/normalize.ts) ; `muscles` garde les noms
// canoniques pour l'affichage et le prompt de génération.
model MuscleCombo {
  id          String   @id @default(cuid())
  key         String   @unique
  muscles     String[]
  imageUrl    String?
  imageTaskId String?
  createdAt   DateTime @default(now())
}

model LocationEquipment {
  locationId  String
  equipmentId String
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([locationId, equipmentId])
}

model Program {
  id          String       @id @default(cuid())
  name        String
  description String?
  goal        String?
  level       String?
  locationId  String?
  location    Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  days        ProgramDay[]
  createdAt   DateTime     @default(now())
  // Durée du bloc en cycles complets (passages sur tous les jours), décidée
  // par l'IA à la génération. null = pas de suivi de bloc.
  blockCycles Int?
  // N° du bloc dans la chaîne de progression (1 = bloc initial).
  blockNumber Int          @default(1)
  // Bloc précédent dans la chaîne (un seul successeur par bloc).
  previousProgramId String?  @unique
  previousProgram   Program? @relation("ProgramBlocks", fields: [previousProgramId], references: [id], onDelete: SetNull)
  nextProgram       Program? @relation("ProgramBlocks")
  // Archivé automatiquement quand son successeur est enregistré.
  archivedAt  DateTime?
}

model ProgramDay {
  id        String           @id @default(cuid())
  programId String
  program   Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  dayIndex  Int
  name      String
  focus     String?
  exercises Exercise[]
  sessions  WorkoutSession[]
}

model Exercise {
  id          String              @id @default(cuid())
  dayId       String
  day         ProgramDay          @relation(fields: [dayId], references: [id], onDelete: Cascade)
  order       Int
  name        String
  sets        Int
  reps        String
  restSeconds Int
  weightHint  String?
  equipment   String[]
  // Muscles principaux travaillés (en français), renseignés par l'IA.
  muscles     String[]            @default([])
  // Temps cible pour boucler l'exercice (séries + repos), défini par l'IA.
  targetSeconds     Int?
  // Temps cible d'exécution d'UNE série, défini par l'IA.
  setSeconds        Int?
  // Temps de transition vers l'exercice suivant (installation), défini par l'IA.
  transitionSeconds Int?
  notes       String?
  imageUrl    String?
  imageTaskId String?
  // Vidéo de démonstration du mouvement (Seedance via Kie.ai) et le prompt
  // détaillé qui a servi à la générer.
  videoUrl    String?
  videoTaskId String?
  videoPrompt String?
  setLogs     SetLog[]
  variations  ExerciseVariation[]
}

// Variante d'un exercice (mêmes muscles), jouée en alternance selon les passages.
model ExerciseVariation {
  id          String   @id @default(cuid())
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  order       Int
  name        String
  sets        Int
  reps        String
  restSeconds Int
  weightHint  String?
  equipment   String[]
  // Muscles principaux travaillés (en français), renseignés par l'IA.
  muscles     String[] @default([])
  // Temps cible pour boucler la variante (séries + repos), défini par l'IA.
  targetSeconds Int?
  // Temps cible d'exécution d'UNE série, défini par l'IA.
  setSeconds    Int?
  notes       String?
  imageUrl    String?
  imageTaskId String?
  videoUrl    String?
  videoTaskId String?
  videoPrompt String?
}

model WorkoutSession {
  id               String     @id @default(cuid())
  dayId            String
  day              ProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  startedAt        DateTime   @default(now())
  completedAt      DateTime?
  notes            String?
  aiFeedback       String?
  setLogs          SetLog[]
  // N° de passage sur ce jour, figé au démarrage de la séance.
  cycleIndex       Int        @default(0)
  // Overrides manuels de variante : { [exerciseId]: index choisi }.
  variationChoices Json       @default("{}")
  // Temps passé par exercice (secondes) : { [exerciseId]: secondes }.
  exerciseSeconds  Json       @default("{}")
}

model SetLog {
  id            String         @id @default(cuid())
  sessionId     String
  session       WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  setIndex      Int
  reps          Int?
  weightKg      Float?
  done          Boolean        @default(false)
  // Nom de la variante réellement exécutée (null = exercice de base).
  variationName String?

  @@unique([sessionId, exerciseId, setIndex])
}

model Settings {
  id               Int     @id @default(1)
  openrouterApiKey String?
  openrouterModel  String  @default("openai/gpt-4o-mini")
  // Modèles épinglés, remontés en tête de liste dans le sélecteur.
  pinnedModels     String[]
  kieApiKey        String?
  voiceInput       Boolean @default(true)
  voiceAnnounce    Boolean @default(true)
  // Modèle acceptant l'audio (dictée directe au micro via OpenRouter).
  voiceModel       String  @default("google/gemini-2.5-flash")
}
