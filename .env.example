# Postgres hébergé (Neon, Supabase, Railway…)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Mot de passe Postgres du docker-compose — OBLIGATOIRE (aucune valeur par
# défaut). Valeur URL-safe : openssl rand -hex 32
POSTGRES_PASSWORD=""

# Clé de chiffrement (AES-256-GCM) des clés API saisies dans Réglages.
# 32 octets : openssl rand -base64 32. Sans elle, les clés ne peuvent pas être
# enregistrées en base (seules KIE_API_KEY / OPENROUTER_API_KEY sont lues).
# La perdre rend les clés stockées illisibles : il suffit alors de les ressaisir.
SETTINGS_ENCRYPTION_KEY=""

# Nombre de reverse proxies de confiance devant l'app (IP cliente retenue pour
# limiter les tentatives de connexion). Traefik/Coolify : 1 ; Cloudflare +
# Traefik : 2 ; accès direct sans proxy : 0.
TRUSTED_PROXY_HOPS="1"

# Clé API Kie.ai (génération d'images d'exercices) — https://kie.ai
# Peut aussi être saisie dans la page Réglages de l'application.
KIE_API_KEY=""

# Clé API OpenRouter (génération des programmes par IA) — https://openrouter.ai
# Peut aussi être saisie dans la page Réglages de l'application.
OPENROUTER_API_KEY=""

# Secret de signature des sessions Better Auth. Obligatoire en production.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Le changer déconnecte tout le monde.
BETTER_AUTH_SECRET=""

# URL publique de l'application (sans barre oblique finale), utilisée par
# Better Auth pour ses redirections et le domaine du cookie de session.
BETTER_AUTH_URL="http://localhost:3000"

# Jeton à usage unique protégeant la page /setup, qui crée le tout premier
# compte administrateur et lui rattache les données déjà présentes en base.
# Sans lui, /setup est inaccessible. Il peut être retiré une fois le compte créé.
SETUP_TOKEN=""
